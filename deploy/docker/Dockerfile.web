FROM node:26-alpine AS build
WORKDIR /app
COPY src/Atlas.Web/package.json src/Atlas.Web/package-lock.json ./
RUN npm ci
COPY src/Atlas.Web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS final
# nginx's entrypoint renders /etc/nginx/templates/*.template with envsubst into conf.d at start.
ENV ATLAS_API_UPSTREAM=atlas-api:8080
ENV ATLAS_DNS_RESOLVER=127.0.0.11
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
