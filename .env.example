# Copy to .env and set strong values. Never commit .env.
ATLAS_DB_PASSWORD=change-me
ATLAS_MINIO_PASSWORD=change-me
# 32 random bytes, base64. Linux/macOS: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
ATLAS_SECRETS_HMAC_KEY=base64-32-bytes-change-me
# Master key for stored connector credentials (AES-256-GCM). 32 random bytes, base64. Back it up: losing it loses the credentials.
ATLAS_MASTER_KEY=base64-32-bytes-change-me
# Host folders exposed read-only as source roots (the folder picker in the UI navigates them).
# Use forward slashes on Windows, e.g. E:/Projetos or C:/Users/me/Documents/GitHub. Up to three roots.
ATLAS_LOCAL_SOURCES=./samples
ATLAS_LOCAL_SOURCES_2=./samples
ATLAS_LOCAL_SOURCES_3=./samples

# Tier 2 analysis (dotnet restore in the scan sandbox). Requires the SDK worker image:
# docker compose build --build-arg ATLAS_WORKER_BASE=mcr.microsoft.com/dotnet/sdk:10.0 atlas-worker
ATLAS_TIER2_ENABLED=false

# Local model (docker compose --profile ai-local up -d). qwen2.5-coder:7b ≈ 4.7 GB; smaller: qwen2.5-coder:1.5b.
ATLAS_LOCAL_MODEL=qwen2.5-coder:7b
ATLAS_LOCAL_MODEL_MEMORY=10g
# Optional OIDC sign-in for the web UI and API (leave ATLAS_AUTH_ENABLED=false for a single-user install).
# Authority = issuer URL (e.g. https://login.microsoftonline.com/<tenant>/v2.0 or https://keycloak/realms/atlas);
# ClientId = public SPA client with redirect URI http://<host>:3000/auth/callback (authorization code + PKCE);
# Audience = the API's expected `aud` (optional).
ATLAS_AUTH_ENABLED=false
ATLAS_AUTH_AUTHORITY=
ATLAS_AUTH_CLIENT_ID=
ATLAS_AUTH_AUDIENCE=
