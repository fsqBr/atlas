<Project Sdk="Microsoft.NET.Sdk">

  <!-- Governance module, application layer: ports, handlers and the cost sync. Depends on the
       core application layer for tenancy and the encrypted credential store; never the reverse. -->

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Governance.Domain\Atlas.Governance.Domain.csproj" />
    <ProjectReference Include="..\Atlas.Application\Atlas.Application.csproj" />
    <ProjectReference Include="..\Atlas.Domain\Atlas.Domain.csproj" />
    <ProjectReference Include="..\Atlas.Security.Redaction\Atlas.Security.Redaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pricing\ai-prices.json" LogicalName="Atlas.Governance.Application.ai-prices.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atlas.Governance.Tests" />
  </ItemGroup>

</Project>
